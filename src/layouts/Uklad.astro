---
// Układ każdej strony: <head> (SEO, obraz do udostępniania, ikony, JSON-LD), belka górna z menu,
// treść, stopka, dwa okienka (nieaktywne do Z6) i pasek „Porozmawiaj z Arthurem” na dole ekranu telefonu.
import '../styles/witryna.css';
import Belka from '../components/Belka.astro';
import Stopka from '../components/Stopka.astro';
import Okna from '../components/Okna.astro';
import Wezwanie from '../components/bloki/Wezwanie.astro';
import type { Kontekst } from '../lib/kontekst';

interface Props {
  tytul: string;
  opis?: string;
  adres: string;
  og?: { plik: string; alt: string };
  indeksuj?: boolean;
  jsonld?: unknown;
  rozdzialy?: { kotwica: string; etykieta: string }[];
  ust: any;
  stopkaPrev?: string;
}
const { tytul, opis, adres, og, indeksuj = true, jsonld, rozdzialy = [], ust, stopkaPrev = '1' } = Astro.props;

// Adres tymczasowy: żadna strona nie trafia do wyszukiwarek, dopóki na Netlify nie ma PUBLIKACJA=tak.
const publikacja = process.env.PUBLIKACJA === 'tak';
const robots = publikacja && indeksuj ? 'index, follow' : 'noindex, nofollow';
const site = Astro.site ?? new URL(ust.marka.domena);
const kanoniczny = new URL(adres === '/' ? '/' : adres, ust.marka.domena).href;
const urlStrony = new URL(adres, site).href;
const ogObraz = og && og.plik ? new URL(og.plik, site).href : undefined;
const k: Kontekst = { ust, baza: new Map(), adres };
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tytul}</title>
    {opis && <meta name="description" content={opis} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={kanoniczny} />
    <meta name="theme-color" content="#F2EFE6" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={ust.marka.nazwa} />
    <meta property="og:title" content={tytul} />
    {opis && <meta property="og:description" content={opis} />}
    <meta property="og:url" content={urlStrony} />
    {ogObraz && <meta property="og:image" content={ogObraz} />}
    {ogObraz && <meta property="og:image:width" content="1200" />}
    {ogObraz && <meta property="og:image:height" content="630" />}
    {ogObraz && og!.alt && <meta property="og:image:alt" content={og!.alt} />}
    <meta name="twitter:card" content={ogObraz ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bona+Nova:wght@700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <Belka ust={ust} adres={adres} rozdzialy={rozdzialy} />

    <main id="tresc">
      <slot />
    </main>

    <Stopka ust={ust} adres={adres} prev={stopkaPrev} />

    {ust.naglowek.przycisk_staly && (
      <div class="stale">
        <Wezwanie b={{ rodzaj: 'glowne' }} k={k} />
      </div>
    )}

    <Okna ust={ust} />

    <script>
      const menu = document.getElementById('menu') as HTMLDetailsElement | null;

      // przyciski CTA otwierają swoje okienko (data-okno = id okienka)
      document.addEventListener('click', (e) => {
        const cel = e.target as HTMLElement;
        const przycisk = cel.closest('[data-okno]') as HTMLElement | null;
        if (przycisk) {
          const okno = document.getElementById(przycisk.dataset.okno || '') as HTMLDialogElement | null;
          if (okno) {
            e.preventDefault();
            if (menu) menu.open = false;
            okno.showModal();
          }
          return;
        }
        // kliknięcie w tło okienka je zamyka
        if (cel instanceof HTMLDialogElement && cel.open) cel.close();
        // menu: zamknij po wyborze pozycji albo po kliknięciu poza nim
        if (menu && menu.open && (cel.closest('.menu__panel a') || !cel.closest('#menu'))) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu && menu.open) menu.open = false;
      });

      // adres z kotwicą pytania (/pytania#id) otwiera kartę pytania
      const otworzPytanie = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        const el = document.getElementById(id);
        if (el instanceof HTMLDetailsElement) el.open = true;
      };
      otworzPytanie();
      window.addEventListener('hashchange', otworzPytanie);
    </script>
  </body>
</html>
