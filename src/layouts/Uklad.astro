---
// Układ każdej strony: <head> (SEO, obraz do udostępniania, ikony, JSON-LD), nagłówek z menu,
// stopka i okienko „Porozmawiaj z Arthurem”.
import '../styles/witryna.css';
import { inline, NIEISTNIEJACE } from '../lib/tekst';

interface Props {
  tytul: string;
  opis?: string;
  adres: string;
  og?: { plik: string; alt: string };
  indeksuj?: boolean;
  jsonld?: unknown;
  rozdzialy?: { kotwica: string; etykieta: string }[];
  ust: any;
  stopkaPrev?: string;
}
const { tytul, opis, adres, og, indeksuj = true, jsonld, rozdzialy = [], ust, stopkaPrev = '1' } = Astro.props;

// Adres tymczasowy: żadna strona nie trafia do wyszukiwarek, dopóki na Netlify nie ma PUBLIKACJA=tak.
const publikacja = process.env.PUBLIKACJA === 'tak';
const robots = publikacja && indeksuj ? 'index, follow' : 'noindex, nofollow';
const site = Astro.site ?? new URL(ust.marka.domena);
const kanoniczny = new URL(adres === '/' ? '/' : adres, ust.marka.domena).href;
const urlStrony = new URL(adres, site).href;
const ogObraz = og && og.plik ? new URL(og.plik, site).href : undefined;
const okno = ust.okno_rozmowy;
const zakup = ust.wezwania.zakupowe;
const zakupAktywny = !NIEISTNIEJACE.includes(zakup.adres);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tytul}</title>
    {opis && <meta name="description" content={opis} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={kanoniczny} />
    <meta name="theme-color" content="#F2EFE6" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={ust.marka.nazwa} />
    <meta property="og:title" content={tytul} />
    {opis && <meta property="og:description" content={opis} />}
    <meta property="og:url" content={urlStrony} />
    {ogObraz && <meta property="og:image" content={ogObraz} />}
    {ogObraz && <meta property="og:image:width" content="1200" />}
    {ogObraz && <meta property="og:image:height" content="630" />}
    {ogObraz && og!.alt && <meta property="og:image:alt" content={og!.alt} />}
    <meta name="twitter:card" content={ogObraz ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bona+Nova:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <header class="naglowek">
      <div class="wrap">
        <a class="logo" href="/"><img src={ust.marka.logo.plik} alt={ust.marka.logo.alt} width="92" height="34" /></a>
        <span class="naglowek__panel nieaktywny" title="Panel klienta: osobna aplikacja, w przygotowaniu">{ust.naglowek.panel_klienta}</span>
        {ust.naglowek.przycisk_staly && (
          <div class="stale">
            <button type="button" class="przycisk" data-okno>{ust.wezwania.glowne.przycisk}</button>
          </div>
        )}
        <details class="menu" id="menu">
          <summary>{ust.naglowek.menu}</summary>
          <nav class="menu__panel" aria-label={ust.naglowek.menu}>
            {rozdzialy.length > 0 && (
              <div class="menu__grupa">
                <p>{ust.naglowek.grupa_rozdzialy}</p>
                <ul>{rozdzialy.map((r) => <li><a href={`#${r.kotwica}`} set:html={inline(r.etykieta)} /></li>)}</ul>
              </div>
            )}
            <div class="menu__grupa">
              <p>{ust.naglowek.grupa_strony}</p>
              <ul>
                {ust.nawigacja.strony.map((s: any) => (
                  <li><a href={s.adres} aria-current={s.adres === adres ? 'page' : undefined}>{s.tekst}</a></li>
                ))}
              </ul>
            </div>
            <div class="menu__dol">
              {zakupAktywny
                ? <a class="przycisk" href={zakup.adres}>{zakup.przycisk}</a>
                : <button type="button" class="przycisk przycisk--nieaktywny" aria-disabled="true" title="Zamówienie online jest w przygotowaniu">{zakup.przycisk}</button>}
              <span class="nieaktywny" title="Panel klienta: osobna aplikacja, w przygotowaniu">{ust.naglowek.panel_klienta}</span>
            </div>
          </nav>
        </details>
      </div>
    </header>

    <main id="tresc">
      <slot />
    </main>

    <footer class={`sekcja ton-3 stopka prev-${stopkaPrev}`}>
      <div class="wrap k2 k2--asym-odw">
        <div style="display:grid;gap:14px;align-content:start">
          {ust.stopka.wezwanie_glowne && (
            <div class="wezwania"><button type="button" class="przycisk" data-okno>{ust.wezwania.glowne.przycisk}</button></div>
          )}
          <p class="jawnosc" set:html={inline(ust.stopka.jawnosc)} />
          <p class="male">{ust.stopka.kontakt_etykieta} <a href={`mailto:${ust.firma.email}`}>{ust.firma.email}</a></p>
          <p class="male" set:html={inline(ust.stopka.prywatnosc)} />
          <p class="male" set:html={inline(ust.stopka.prawa)} />
        </div>
        <nav aria-label="Strony witryny">
          <ul>
            {ust.nawigacja.strony.map((s: any) => <li><a href={s.adres}>{s.tekst}</a></li>)}
            <li>{zakupAktywny ? <a href={zakup.adres}>{zakup.przycisk}</a> : <span class="nieaktywny" title="Zamówienie online jest w przygotowaniu">{zakup.przycisk}</span>}</li>
            <li><span class="nieaktywny" title="Panel klienta: osobna aplikacja, w przygotowaniu">{ust.naglowek.panel_klienta}</span></li>
            {ust.stopka.linki_prawne.map((l: any) => <li><a href={l.adres}>{l.tekst}</a></li>)}
          </ul>
        </nav>
      </div>
    </footer>

    <dialog class="okno" id="okno-rozmowy" aria-labelledby="okno-tytul">
      <form class="okno__karta" method="dialog">
        <h2 id="okno-tytul">{okno.tytul}</h2>
        <p set:html={inline(okno.wstep)} />
        <p class="okno__info">Formularz jeszcze nie działa. Włączymy go po przygotowaniu polityki prywatności i oceny skutków dla ochrony danych.</p>
        <label>{okno.pole_numer}<input type="tel" inputmode="tel" autocomplete="tel" disabled /></label>
        <fieldset disabled>
          <legend>{okno.pytanie_kiedy}</legend>
          <label class="wybor"><input type="radio" name="kiedy" value="teraz" checked /> {okno.opcja_teraz}</label>
          <label class="wybor"><input type="radio" name="kiedy" value="termin" /> {okno.opcja_termin}</label>
          <label>{okno.pole_data}<input type="date" /></label>
          <label>{okno.pole_godzina}<input type="time" /></label>
        </fieldset>
        <p class="male" set:html={inline(okno.zgoda)} />
        <button type="button" class="przycisk przycisk--nieaktywny" aria-disabled="true">{okno.przycisk}</button>
        <button type="submit" class="okno__zamknij">Zamknij</button>
      </form>
    </dialog>

    <script>
      const okno = document.getElementById('okno-rozmowy') as HTMLDialogElement | null;
      const menu = document.getElementById('menu') as HTMLDetailsElement | null;
      document.addEventListener('click', (e) => {
        const cel = (e.target as HTMLElement).closest('[data-okno]');
        if (cel && okno) {
          e.preventDefault();
          if (menu) menu.open = false;
          okno.showModal();
          return;
        }
        if (okno && e.target === okno) okno.close();
        if (menu && menu.open && (e.target as HTMLElement).closest('.menu a')) menu.open = false;
        if (menu && menu.open && !(e.target as HTMLElement).closest('#menu')) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu) menu.open = false;
      });
    </script>
  </body>
</html>
