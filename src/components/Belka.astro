---
// Belka górna, od lewej: logo · Menu · Cena · Kontakt · Zamów online · Panel klienta (teksty i adresy: Ustawienia → naglowek).
// Na telefonie w belce zostają logo i Menu, a pozostałe pozycje stoją na górze panelu menu.
//
// Menu (decyzje z 12.11.2026): jedna lista. Po lewej strony z nawigacja.strony (nagłówek naglowek.grupa_strony),
// oglądana strona wyróżniona. Po prawej rozdziały jednej strony pod napisem „Na stronie <nazwa strony>”:
// na początku strony oglądanej, a po kliknięciu strzałki obok innej strony – jej rozdziałów.
// Nazwa strony prowadzi na jej początek, strzałka pokazuje jej rozdziały (tak samo myszą i palcem).
// Na telefonie to samo jako lista stron, w której rozdziały rozwijają się pod stroną; na początku rozwinięta jest oglądana.
// Pozycje menu są zwykłymi linkami, a nie przyciskami.
import { getCollection } from 'astro:content';
import { inline, dziala } from '../lib/tekst';
import { rozdzialyStrony } from '../lib/nawigacja';
interface Props { ust: any; adres: string }
const { ust, adres } = Astro.props;
const n = ust.naglowek;
const zakup = ust.wezwania.zakupowe;
const zakupCzynny = dziala(zakup.adres);
const panelCzynny = dziala(ust.firma.panel_klienta);

const wpisy = await getCollection('strony');
const poAdresie = new Map(wpisy.map((w: any) => [w.data.seo.adres, w.data]));
const strony = ust.nawigacja.strony.map((s: any, i: number) => {
  const biezaca = s.adres === adres;
  const rozdzialy = rozdzialyStrony(poAdresie.get(s.adres)).map((r) => ({
    ...r,
    href: `${s.adres === '/' ? '/' : s.adres}#${r.kotwica}`,
  }));
  return { ...s, i, biezaca, rozdzialy, naglowek: `${n.grupa_rozdzialy} ${s.tekst}` };
});
---
<header class="belka">
  <div class="wrap belka__wnetrze">
    <a class="logo" href="/"><img src={ust.marka.logo.plik} alt={ust.marka.logo.alt} width="92" height="34" /></a>
    <details class="menu" id="menu">
      <summary class="menu__przycisk">{n.menu}</summary>
      <div class="menu__panel">
        <div class="menu__belka">
          <ul class="menu__linki">
            {n.linki.map((l: any) => <li><a href={l.adres}>{l.tekst}</a></li>)}
          </ul>
          {zakupCzynny
            ? <a class="cta cta--male" href={zakup.adres}>{n.zakup}</a>
            : <button type="button" class="cta cta--male cta--nieaktywny" aria-disabled="true">{n.zakup}</button>}
          {panelCzynny
            ? <a class="belka__panel" href={ust.firma.panel_klienta}>{n.panel_klienta}</a>
            : <span class="belka__panel nieaktywny" aria-disabled="true">{n.panel_klienta}</span>}
        </div>
        <nav class="menu__lewa" aria-label={n.grupa_strony}>
          <p class="menu__etykieta">{n.grupa_strony}</p>
          <ul class="menu__strony">
            {strony.map((s: any) => (
              <li class={s.biezaca ? 'menu__strona aktywna' : 'menu__strona'} data-strona={s.i}>
                <div class="menu__wiersz">
                  <a href={s.adres} aria-current={s.biezaca ? 'page' : undefined}>{s.tekst}</a>
                  {s.rozdzialy.length > 0 && (
                    <button type="button" class="menu__strzalka" data-strona={s.i}
                      aria-expanded={s.biezaca ? 'true' : 'false'}
                      aria-controls={`menu-w-${s.i} menu-k-${s.i}`}
                      aria-label={s.naglowek}></button>
                  )}
                </div>
                {s.rozdzialy.length > 0 && (
                  <ul class="menu__rozdzialy menu__rozdzialy--wiersz" id={`menu-w-${s.i}`}>
                    {s.rozdzialy.map((r: any) => <li><a href={r.href} set:html={inline(r.etykieta)} /></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <div class="menu__prawa">
          {strony.filter((s: any) => s.rozdzialy.length > 0).map((s: any) => (
            <nav class={s.biezaca ? 'menu__kolumna aktywna' : 'menu__kolumna'} id={`menu-k-${s.i}`} data-strona={s.i} aria-label={s.naglowek}>
              <p class="menu__etykieta">{n.grupa_rozdzialy} <span class="menu__nazwa">{s.tekst}</span></p>
              <ul class="menu__rozdzialy">
                {s.rozdzialy.map((r: any) => <li><a href={r.href} set:html={inline(r.etykieta)} /></li>)}
              </ul>
            </nav>
          ))}
        </div>
      </div>
    </details>
    <nav class="belka__linki" aria-label={n.menu}>
      {n.linki.map((l: any) => <a href={l.adres}>{l.tekst}</a>)}
    </nav>
    <div class="belka__prawo">
      {zakupCzynny
        ? <a class="cta cta--male" href={zakup.adres}>{n.zakup}</a>
        : <button type="button" class="cta cta--male cta--nieaktywny" aria-disabled="true">{n.zakup}</button>}
      {panelCzynny
        ? <a class="belka__panel" href={ust.firma.panel_klienta}>{n.panel_klienta}</a>
        : <span class="belka__panel nieaktywny" aria-disabled="true">{n.panel_klienta}</span>}
    </div>
  </div>
</header>
