---
// Cała strona z pliku treści: wejście i rozdziały w kolejności z CMS.
// Tutaj liczymy przejścia tonalne między rozdziałami i stronę zdjęcia w rozdziale.
import Uklad from '../layouts/Uklad.astro';
import Wejscie from './Wejscie.astro';
import Sekcja from './Sekcja.astro';
import { getEntry } from 'astro:content';
import { tonNr } from '../lib/tekst';
import type { Kontekst } from '../lib/kontekst';

interface Props { wpis: any }
const { wpis } = Astro.props;
const dane = wpis.data;
const ust = (await getEntry('ustawienia', 'witryna'))!.data;
const bazaWpis = await getEntry('pytania', 'baza');
const baza = new Map<string, any>((bazaWpis?.data.pytania ?? []).map((q: any) => [q.id, q]));
const k: Kontekst = { ust, baza, adres: dane.seo.adres };

// Dane strukturalne z docs/jsonld/<strona>.json (generuje narzedzia/buduj_pochodne.py przy każdym budowaniu)
const jsonldPliki = import.meta.glob('../../docs/jsonld/*.json', { eager: true, import: 'default' });
const jsonld = jsonldPliki[`../../docs/jsonld/${wpis.id}.json`];

const blad = dane.strona.szablon === 'blad';
const sekcje = dane.sekcje ?? [];

// przejścia tonalne: każdy rozdział zna ton poprzedniego (wejście kończy się tonem 5, strona błędu tonem 1);
// zdjęcia w rozdziałach na przemian: pierwsze z prawej, drugie z lewej…
let prev = blad ? '1' : '5';
let nrZdjecia = 0;
const lista = sekcje.map((s: any) => {
  const maZdjecie = !!(s.zdjecie && s.zdjecie.widoczne !== false && s.zdjecie.plik);
  const strona: 'L' | 'P' = maZdjecie && nrZdjecia++ % 2 === 1 ? 'L' : 'P';
  const w = { s, prev, strona };
  prev = tonNr(s.ton);
  return w;
});
---
<Uklad
  tytul={dane.seo.tytul}
  opis={dane.seo.opis}
  adres={dane.seo.adres}
  og={dane.seo.obraz_og}
  indeksuj={dane.seo.indeksuj}
  jsonld={jsonld}
  ust={ust}
  stopkaPrev={prev}
>
  <Wejscie dane={dane} k={k} />
  {lista.map((x: any) => <Sekcja s={x.s} k={k} prev={x.prev} strona={x.strona} />)}
</Uklad>
