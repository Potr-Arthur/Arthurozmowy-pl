---
// Moduł „FAQ”: trzy karty pytań z bazy i pod nimi link „Wszystkie pytania” bez „Więcej:” (→ /pytania, tekst z Ustawień; decyzja z 12.11.2026).
import KartaPytania from './KartaPytania.astro';
import Link from './Link.astro';
import type { Kontekst } from '../../lib/kontekst';
interface Props { b: { pytania: string[] }; k: Kontekst }
const { b, k } = Astro.props;
const lista = b.pytania.map((id) => k.baza.get(id)).filter(Boolean);
---
<div class="karty-pytan">
  {lista.map((q: any) => <KartaPytania q={q} k={k} />)}
</div>
<Link b={{ tekst: k.ust.nawigacja.wszystkie_pytania, adres: '/pytania' }} k={k} bezWiecej />
