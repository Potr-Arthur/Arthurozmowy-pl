---
// Wejście strony.
//   HERO1 (strona główna): zdjęcie od krawędzi do krawędzi, dół przechodzi w tło; pod nim H1, lid i wezwania asymetrycznie.
//   HERO2 (podstrony): duże kwadratowe zdjęcie obok H1, zdjęcie zaczyna się na wysokości górnej linii H1.
//   Strona błędu: bez zdjęcia.
import Zdjecie from './Zdjecie.astro';
import Wezwania from './Wezwania.astro';
import Linki from './Linki.astro';
import { akapity, h1Html, dataPl, dataIso } from '../lib/tekst';
interface Props { dane: any; ust: any }
const { dane, ust } = Astro.props;
const w = dane.wejscie;
const szablon = dane.strona.szablon;
const lid = akapity(w.lid);
const id = w.kotwica || 'wejscie';
const zdjecieWidoczne = !!(w.zdjecie && w.zdjecie.widoczne && w.zdjecie.plik_desktop);
---
{szablon === 'glowna' && (
  <section class="sekcja sekcja--pierwsza hero1" id={id}>
    <Zdjecie zdjecie={w.zdjecie} rodzaj="pelne" odRazu />
    <div class="hero1__dol ton-hero">
      <div class="wrap hero1__tekst">
        <h1 set:html={h1Html(w.h1, w.h1_wyroznienie)} />
        <div class="hero1__lid">
          {lid.map((p) => <p set:html={p} />)}
        </div>
        <Wezwania w={w.wezwania} ust={ust} />
      </div>
    </div>
  </section>
)}
{szablon === 'podstrona' && (
  <section class="sekcja sekcja--pierwsza ton-hero hero2" id={id}>
    <div class="wrap">
      <div class={zdjecieWidoczne ? 'hero2__siatka' : 'red__tresc red--srodek'}>
        <Zdjecie zdjecie={w.zdjecie} rodzaj="kwadrat" odRazu />
        <div class="hero2__tekst">
          <h1 set:html={h1Html(w.h1, w.h1_wyroznienie)} />
          {lid.map((p) => <p class="lid" set:html={p} />)}
          {w.pokaz_autora_i_date && (
            <p class="autor">
              Autor: <a href={ust.autor.adres_strony}>{dane.seo.autor}</a> · Zaktualizowano <time datetime={dataIso(dane.seo.zaktualizowano)}>{dataPl(dane.seo.zaktualizowano)}</time>
            </p>
          )}
          <Wezwania w={w.wezwania} ust={ust} />
        </div>
      </div>
    </div>
  </section>
)}
{szablon === 'blad' && (
  <section class="sekcja sekcja--pierwsza sekcja--blad ton-1" id={id}>
    <div class="wrap">
      <div class="red__tresc red--srodek">
        <h1 set:html={h1Html(w.h1, w.h1_wyroznienie)} />
        {lid.map((p) => <p set:html={p} />)}
        <div class="wezwania">
          {w.przycisk_powrotu && <a class="przycisk" href={w.przycisk_powrotu.adres}>{w.przycisk_powrotu.tekst}</a>}
        </div>
        <Linki linki={w.linki} strony={ust.nawigacja.strony} />
        <Wezwania w={w.wezwania} ust={ust} />
      </div>
    </div>
  </section>
)}
