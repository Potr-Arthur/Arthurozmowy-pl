---
// Zdjęcie w dwóch kadrach: -tel na telefonie, -desk na komputerze. Pokazujemy tylko przy widoczne: true.
// Wymiary w atrybutach, żeby układ nie skakał przy ładowaniu.
interface Props {
  zdjecie?: { widoczne?: boolean; plik_desktop?: string; plik_telefon?: string; alt?: string };
  rodzaj: 'hero' | 'pion';
  odRazu?: boolean;
}
const { zdjecie, rodzaj, odRazu = false } = Astro.props;
const pokaz = !!(zdjecie && zdjecie.widoczne && zdjecie.plik_desktop);
const desk = rodzaj === 'hero' ? { w: 2100, h: 900 } : { w: 900, h: 1200 };
const tel = { w: 1200, h: 900 };
const ramka = rodzaj === 'hero' ? 'foto-ramka foto-ramka--hero' : 'foto-ramka foto-ramka--pion';
const figura = rodzaj === 'hero' ? 'foto foto--hero foto--img' : 'foto foto--pion foto--img';
---
{pokaz && (
  <div class={ramka}>
    <figure class={figura}>
      <picture>
        {zdjecie!.plik_telefon && (
          <source media="(max-width: 759px)" srcset={zdjecie!.plik_telefon} width={tel.w} height={tel.h} />
        )}
        <img
          src={zdjecie!.plik_desktop}
          alt={zdjecie!.alt ?? ''}
          width={desk.w}
          height={desk.h}
          loading={odRazu ? 'eager' : 'lazy'}
          decoding={odRazu ? 'sync' : 'async'}
          fetchpriority={odRazu ? 'high' : undefined}
        />
      </picture>
    </figure>
  </div>
)}
