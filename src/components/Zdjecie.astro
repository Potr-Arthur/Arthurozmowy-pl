---
// Zdjęcie w dwóch kadrach: -tel na telefonie, -desk na komputerze. Pokazujemy tylko przy widoczne: true.
// Wymiary w atrybutach, żeby układ nie skakał przy ładowaniu. Kadr na ekranie robi CSS (object-fit).
//   pelne   – HERO1 strony głównej, od krawędzi do krawędzi, dół przechodzi w tło
//   kwadrat – HERO2 podstron, duży kwadrat obok H1
//   sekcja  – zdjęcie w rozdziale, 4:5, przyklejone przy przewijaniu długiego tekstu
interface Props {
  zdjecie?: { widoczne?: boolean; plik_desktop?: string; plik_telefon?: string; alt?: string };
  rodzaj: 'pelne' | 'kwadrat' | 'sekcja';
  odRazu?: boolean;
}
const { zdjecie, rodzaj, odRazu = false } = Astro.props;
const pokaz = !!(zdjecie && zdjecie.widoczne && zdjecie.plik_desktop);
const desk = rodzaj === 'pelne' ? { w: 2100, h: 900 } : { w: 900, h: 1200 };
const tel = { w: 1200, h: 900 };
const ramka = rodzaj === 'pelne' ? 'hero1__foto' : `foto-ramka foto-ramka--pion red__foto red__foto--${rodzaj}`;
const figura = rodzaj === 'pelne' ? 'hero1__figura' : `foto foto--pion foto--img foto--${rodzaj}`;
---
{pokaz && (
  <div class={ramka}>
    <figure class={figura}>
      <picture>
        {zdjecie!.plik_telefon && (
          <source media="(max-width: 759px)" srcset={zdjecie!.plik_telefon} width={tel.w} height={tel.h} />
        )}
        <img
          src={zdjecie!.plik_desktop}
          alt={zdjecie!.alt ?? ''}
          width={desk.w}
          height={desk.h}
          loading={odRazu ? 'eager' : 'lazy'}
          decoding={odRazu ? 'sync' : 'async'}
          fetchpriority={odRazu ? 'high' : undefined}
        />
      </picture>
    </figure>
  </div>
)}
