---
// Rozdział strony: Nagłówek H2, zdjęcie, Lid H2 i bloki w kolejności z pliku treści.
// Układ redakcyjny (6.11.2026):
//   bez zdjęcia – „szyna”: H2 w lewej kolumnie (przyklejony przy przewijaniu), lid i bloki w kolumnie ok. 690 px;
//   ze zdjęciem – tekst 7/12 i zdjęcie 5/12, na przemian z prawej i z lewej; zdjęcie zaczyna się na wysokości
//   górnej linii H2 i zostaje w widoku, gdy tekst jest dłuższy.
import Zdjecie from './Zdjecie.astro';
import Bloki from './Bloki.astro';
import { inline, akapity, tonKlasa } from '../lib/tekst';
import type { Kontekst } from '../lib/kontekst';
interface Props { s: any; k: Kontekst; prev: string; strona: 'L' | 'P' }
const { s, k, prev, strona } = Astro.props;
const f = k.ust.firma;
const zdj = s.zdjecie && s.zdjecie.widoczne !== false && s.zdjecie.plik ? s.zdjecie : null;
const h2 = s.h2 ? inline(s.h2, f) : '';
const lid = akapity(s.lid, f);
const uklad = zdj ? `red red--foto red--${strona}` : `red red--szyna${h2 ? '' : ' red--bez-glowy'}`;
---
<section class={`sekcja ${tonKlasa(s.ton)} prev-${prev}`} id={s.kotwica || undefined}>
  <div class="wrap">
    <div class={uklad}>
      {zdj && <Zdjecie zdjecie={zdj} rodzaj="sekcja" />}
      {!zdj && h2 && <div class="red__glowa"><h2 set:html={h2} /></div>}
      <div class="tresc red__tresc">
        {zdj && h2 && <h2 set:html={h2} />}
        {lid.map((p) => <p class="lid lid--h2" set:html={p} />)}
        <Bloki bloki={s.bloki} k={k} />
      </div>
    </div>
  </div>
</section>
